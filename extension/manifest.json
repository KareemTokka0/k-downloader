{
  "manifest_version": 3,
  "name": "K Downloader",
  "version": "1.3.1",
  "description": "The Download button on YouTube, Facebook, Instagram, TikTok and more, plus a download manager for every file: 16 parallel connections and resume.",
  "author": "Kareem Waheed",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "webRequest",
    "contextMenus",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:17653/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:17653/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "K Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
